<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Unread count badges (#280) -->
    <style name="CountBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:minWidth">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TextAppearance.VerySmall" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.VerySmall.Bold">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="TextAppearance.ItemTitle" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TextAppearance.HeaderTitle" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TextAppearance.CountHeaderItem" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TextAppearance.Header" parent="TextAppearance.AppCompat.Body1">
        <!-- Use theme text primary (dark #1F1E24) — was abc_primary_text_material_dark (white) -->
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.NotificationEmphasized" parent="android:TextAppearance.Material.Notification.Emphasis" />

    <style name="TextAppearance.SmallUrl" parent="@android:style/TextAppearance.Small">
        <item name="android:textColor">?android:attr/textColorLink</item>
    </style>

    <style name="TextAppearance.SmallUrl.Sha">
        <item name="android:typeface">monospace</item>
    </style>

    <style name="LoadingProgress">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:indeterminateBehavior">repeat</item>
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateOnly">true</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>

    <style name="MoreButton" parent="SelectableLabel">
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textSize">@dimen/abc_text_size_button_material</item>
        <!-- As written, as GitLab does (#292) -->
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SelectableItem">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="SelectableBorderlessItem">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="SelectableLabel" parent="SelectableItem">
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.ItemTitle</item>
    </style>

    <style name="HeaderLabel">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Medium</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:paddingLeft">@dimen/content_padding</item>
        <item name="android:paddingRight">@dimen/content_padding</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <!-- Section names as written, in sentence case as GitLab writes them (#292) -->
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ReactionBarButton" parent="SelectableBorderlessItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="OverviewRow">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/content_padding</item>
        <item name="android:paddingRight">@dimen/content_padding</item>
    </style>

    <!-- TextInputLayout override: force hint colour and error colour to theme-controlled values.
         Changing @color/theme_hint or @color/form_error propagates to all fields app-wide. -->
    <style name="OctoLab.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="hintTextColor">@color/theme_hint</item>
        <item name="android:textColorHint">@color/theme_hint</item>
        <item name="errorTextColor">@color/form_error</item>
        <item name="errorIconTint">@color/form_error</item>
        <item name="boxStrokeErrorColor">@color/form_error</item>
        <!-- Focused stroke uses brand Purple 02p (#7759C2, 5.26:1) via link_text -->
        <item name="boxStrokeColor">@color/link_text</item>
        <item name="materialThemeOverlay">@style/OctoLab.TextInputEditText.FilledBox</item>
    </style>

    <style name="OctoLab.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/OctoLab.TextInputEditText.OutlinedBox</item>
    </style>

    <!-- Material colours a text field's cursor and selection handles with colorPrimary, which is
         the toolbar's near-white grey here; use the link blue, as HeaderTheme does (#226) -->
    <style name="OctoLab.TextInputEditText.FilledBox" parent="ThemeOverlay.MaterialComponents.TextInputEditText.FilledBox">
        <item name="colorControlActivated">@color/link_text</item>
    </style>

    <style name="OctoLab.TextInputEditText.OutlinedBox" parent="ThemeOverlay.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="colorControlActivated">@color/link_text</item>
    </style>

    <!-- Text buttons (OK/Cancel etc): use brand accent orange instead of colorPrimary (light grey=invisible).
         Orange (2.84:1) is below AA for normal text but accepted as brand exception per user preference. -->
    <style name="OctoLab.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/accent</item>
        <item name="iconTint">@color/accent</item>
    </style>

    <!-- Popup/overflow menu overlay — light mode uses light (white bg, dark text).
         Night mode overrides this in values-night/themes.xml to Dark (dark bg, light text). -->
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Search fields: a hint magnifier that's visible on the light toolbar (#227) -->
    <style name="OctoLab.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="searchHintIcon">@drawable/search_hint_icon</item>
    </style>

    <!-- Toolbar overlay: dark text/icons on light grey primary (16.5:1 WCAG AA).
         Parent must be Light variant — ActionBar (without Light) inherits DarkActionBar white. -->
    <!-- Valid parent: ThemeOverlay.AppCompat.Light gives dark text/icons base.
         Explicit overrides ensure dark colours on light grey toolbar. -->
    <style name="AppTheme.ToolbarOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/theme_text_primary</item>
        <item name="android:textColorSecondary">@color/theme_text_primary</item>
        <item name="colorControlNormal">@color/theme_text_primary</item>
        <item name="colorControlHighlight">@color/theme_text_primary</item>
        <item name="actionMenuTextColor">@color/theme_text_primary</item>
        <item name="android:actionMenuTextColor">@color/theme_text_primary</item>
    </style>

    <style name="CardContainer">
        <item name="android:background">@color/theme_surface</item>
    </style>

    <style name="Widget.ActionBar.TabView" parent="Widget.AppCompat.ActionBar.TabView">
        <item name="android:background">@drawable/tab_indicator</item>
    </style>

    <style name="Widget.Spinner.ActionBar.Light" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/abc_popup_background_mtrl_mult</item>
    </style>

    <style name="TextAppearance.Widget.ActionBar.Menu" parent="TextAppearance.AppCompat.Widget.ActionBar.Menu">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ImageButton" parent="SelectableBorderlessItem">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">center</item>
    </style>


    <!-- Tab titles as written, in sentence case as on GitLab (#292) -->
    <style name="TabText" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- THE outlined badge: roles (#233) and the branch picker's default / protected (#298) -->
    <style name="OutlinedBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:background">@drawable/role_badge_background</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- THE feed row (#287): Your Activity, To-dos and Participating, in the issue timeline's style:
     the avatar sits on the timeline line (TimelineLineDecoration at feed_line_x). -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/v_feed_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clipChildren="false"
    android:paddingBottom="12dp"
    android:paddingLeft="@dimen/feed_side_padding"
    android:paddingRight="4dp"
    android:paddingTop="10dp">

    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="@dimen/feed_avatar_size"
        android:layout_height="@dimen/feed_avatar_size"
        android:clipChildren="false">

        <com.gl4a.widget.FixedSizeImageView
            android:id="@+id/iv_gravatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            tools:src="@drawable/default_avatar" />

        <!-- On a badge from the theme, in the theme's icon colour: WCAG 3:1 at least (#288).
             It hangs over the avatar's corner: nothing clips it (clipChildren), and the 16dp
             icon sits fully inside the 22dp badge. -->
        <com.gl4a.widget.FixedSizeImageView
            android:id="@+id/iv_type_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end|bottom"
            android:layout_marginBottom="-5dp"
            android:layout_marginEnd="-5dp"
            android:background="@drawable/feed_type_badge"
            android:padding="3dp"
            android:tint="?attr/colorControlNormal"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:src="@drawable/issue"
            tools:visibility="visible" />
    </FrameLayout>

    <ImageView
        android:id="@+id/iv_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="-8dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_options"
        android:scaleType="center"
        android:src="@drawable/overflow"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/feed_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@id/iv_action"
        android:layout_toRightOf="@id/avatar_container"
        android:gravity="center_vertical"
        android:minHeight="@dimen/feed_avatar_size"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_actor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textStyle="bold"
            tools:text="Alice Test Bot" />

        <TextView
            android:id="@+id/tv_created_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.VerySmall"
            tools:text="2 hours ago" />
    </LinearLayout>

    <com.gl4a.widget.LinkHandlingTextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@id/feed_header"
        android:layout_below="@id/feed_header"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@id/iv_action"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="?android:textColorPrimary"
        tools:text="mentioned you in Issue #243" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@id/feed_header"
        android:layout_below="@id/tv_title"
        android:layout_marginRight="12dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone"
        tools:text="Notification test 7: before the next release"
        tools:visibility="visible" />

    <com.gl4a.widget.LinkHandlingTextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@id/feed_header"
        android:layout_below="@id/tv_subtitle"
        android:layout_marginRight="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="@integer/event_description_max_lines"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:visibility="gone"
        tools:text="The comment, as GitLab sends it"
        tools:visibility="visible" />

</RelativeLayout>

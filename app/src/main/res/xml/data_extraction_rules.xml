<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) ignores fullBackupContent and requires this file instead.
  The encrypted token store (Gh4a-secure-pref) is excluded on top of being
  Keystore-encrypted: its key is device-bound and would not decrypt after a
  cloud restore or device transfer anyway, so excluding it avoids restoring a
  useless/unreadable file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="Gh4a-secure-pref.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="Gh4a-secure-pref.xml" />
    </device-transfer>
</data-extraction-rules>

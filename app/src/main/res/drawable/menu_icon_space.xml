<?xml version="1.0" encoding="utf-8"?>
<!-- An empty 24dp icon for the "Loading…" reaction menu item: a submenu reserves space for
     icons only if a visible item has one when it opens, so while loading the reaction icons,
     shown a moment later, had no room and were left out (#208) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <size android:width="24dp" android:height="24dp" />
    <solid android:color="@android:color/transparent" />
</shape>

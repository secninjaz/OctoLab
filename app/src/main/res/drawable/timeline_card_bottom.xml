<?xml version="1.0" encoding="utf-8"?>
<!-- Comment card in the timeline, like GitLab web (#179); the last reply of a thread -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/timeline_card_bg" />
    <stroke android:width="1dp" android:color="@color/timeline_card_stroke" />
    <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp" />
</shape>

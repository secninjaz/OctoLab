<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HeaderTheme" parent="Theme.MaterialComponents">
        <item name="colorAccent">@color/link_text</item>
        <item name="colorControlActivated">@color/link_text</item>
        <!-- colorPrimary drives TextInputLayout focused indicator + floating label.
             Must be visible (blue link_text) — theme_surface (#121212) is invisible on dark bg. -->
        <item name="colorPrimary">@color/link_text</item>
        <item name="android:textColorPrimary">@color/theme_text_primary</item>
        <item name="colorOnSurface">@color/theme_text_primary</item>
    </style>

    <!-- Popup/overflow menu in dark mode: dark bg, light text. -->
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

    <style name="CardView.DayNight" parent="CardView.Dark">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/card_margin</item>
        <item name="android:layout_marginRight">@dimen/card_margin</item>
        <item name="android:layout_marginTop">@dimen/card_top_bottom_margin</item>
        <item name="android:layout_marginBottom">@dimen/card_top_bottom_margin</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>
</resources>
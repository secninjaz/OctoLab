<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged into the manifest only for the internal flavor (GitLab CI builds).
    Adds the internal instance as a link host so links to it open in OctoLab.
    The host is the internalGitlabHost placeholder: the GitLab instance running the CI
    pipeline (app/build.gradle), so it isn't in the repository (#305).
    The community flavor has no such filter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".resolver.BrowseFilter">
            <!-- Verified App Links (#302): opened in the app by default, without the user
                 enabling it, once the instance's /.well-known/assetlinks.json names this app -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="${internalGitlabHost}" android:scheme="https" />
                <data android:host="${internalGitlabHost}" android:scheme="http" />
            </intent-filter>
        </activity>
    </application>
</manifest>
